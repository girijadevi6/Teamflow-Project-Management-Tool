# Backend environment variables
# Copy this file to backend/.env and fill in real values

SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./teamflow.db
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated extra origins allowed by CORS (e.g. your deployed
# frontend URL on Render). Local dev origins are always allowed by default.
CORS_ORIGINS=
